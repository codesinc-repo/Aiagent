# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Any Groq chat model that supports tool calling
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: protect the /team dashboard (recommended before sharing the link)
TEAM_PASSCODE=

# Optional: where demo bookings/requests are stored (default: ./.data)
# RALU_DATA_DIR=./.data
